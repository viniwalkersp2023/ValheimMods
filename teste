        // Tudo que toca na API do Jotunn fica isolado aqui: se o Jotunn nao
        // estiver instalado, estes metodos nunca sao JITados/chamados.
        static class JotunnBridge
        {
            public static void SubscribeVanillaPrefabs()
            {
                Jotunn.Managers.PrefabManager.OnVanillaPrefabsAvailable += OnVanilla;
            }
            static void OnVanilla()
            {
                try { Jotunn.Managers.PrefabManager.OnVanillaPrefabsAvailable -= OnVanilla; } catch { }
                Register();
            }
            public static void Register()
            {
                if (ViniTotemPlugin._jotunnRegistered) return;
                try
                {
                    if (Jotunn.Managers.PrefabManager.Instance.GetPrefab("ViniSkillTotem") != null)
                    {
                        ViniTotemPlugin._jotunnRegistered = true;
                        return;
                    }
                    var cfg = new Jotunn.Configs.PieceConfig();
                    cfg.Name = "Totem da Segunda Chance";
                    cfg.Description = "Quem morreu pode recuperar as habilidades perdidas (use com E).";
                    cfg.PieceTable = "Hammer";
                    cfg.Usage = new string[] { "Misc", "Building" };
                    cfg.CraftingStation = "forge";
                    cfg.AddRequirement(new Jotunn.Configs.RequirementConfig() { Item = "FineWood", Amount = 30, Recover = true });
                    cfg.AddRequirement(new Jotunn.Configs.RequirementConfig() { Item = "SurtlingCore", Amount = 5, Recover = true });
                    cfg.AddRequirement(new Jotunn.Configs.RequirementConfig() { Item = "GreydwarfEye", Amount = 10, Recover = true });
                    cfg.AddRequirement(new Jotunn.Configs.RequirementConfig() { Item = "Coins", Amount = 500, Recover = true });
                    Jotunn.Managers.PieceManager.Instance.AddPiece(new Jotunn.Entities.CustomPiece("ViniSkillTotem", "guard_stone", cfg));
                    ViniTotemPlugin._jotunnRegistered = true;
                    ViniTotemPlugin.Log("totem registrado via Jotunn.");
                }
                catch (Exception e) { ViniTotemPlugin.Log("registro Jotunn falhou: " + e.Message); }
            }
