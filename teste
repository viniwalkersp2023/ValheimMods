        static int BvStart(int binStart, List<object> bufferViews, int idx)
        {
            var bv = (Dictionary<string, object>)bufferViews[idx];
            int off = bv.ContainsKey("byteOffset") ? Convert.ToInt32((double)bv["byteOffset"]) : 0;
            return binStart + off;
        }

        static float[] ReadAccFloats(byte[] bytes, int binStart, List<object> accessors, List<object> bufferViews, int idx)
        {
            var acc = (Dictionary<string, object>)accessors[idx];
            int comp = Convert.ToInt32((double)acc["componentType"]);
            int count = Convert.ToInt32((double)acc["count"]);
            string type = (string)acc["type"];
            int comps = type == "VEC3" ? 3 : (type == "VEC2" ? 2 : 1);
            int bv = Convert.ToInt32((double)acc["bufferView"]);
            int ab = acc.ContainsKey("byteOffset") ? Convert.ToInt32((double)acc["byteOffset"]) : 0;
            int start = BvStart(binStart, bufferViews, bv) + ab;
            int sz = comp == 5126 ? 4 : (comp == 5123 ? 2 : 1);
            float[] o = new float[count * comps];
            for (int i = 0; i < count * comps; i++)
            {
                int p = start + i * sz;
                if (comp == 5126) o[i] = BitConverter.ToSingle(bytes, p);
                else if (comp == 5123) o[i] = BitConverter.ToUInt16(bytes, p) / 65535f;
                else if (comp == 5121) o[i] = bytes[p] / 255f;
                else if (comp == 5120) o[i] = ((sbyte)bytes[p]) / 127f;
                else throw new Exception("componentType " + comp);
            }
            return o;
        }

        static int[] ReadAccIndices(byte[] bytes, int binStart, List<object> accessors, List<object> bufferViews, int idx)
        {
            var acc = (Dictionary<string, object>)accessors[idx];
            int comp = Convert.ToInt32((double)acc["componentType"]);
            int count = Convert.ToInt32((double)acc["count"]);
            int bv = Convert.ToInt32((double)acc["bufferView"]);
            int ab = acc.ContainsKey("byteOffset") ? Convert.ToInt32((double)acc["byteOffset"]) : 0;
            int start = BvStart(binStart, bufferViews, bv) + ab;
            int[] o = new int[count];
            for (int i = 0; i < count; i++)
            {
                if (comp == 5125) o[i] = (int)BitConverter.ToUInt32(bytes, start + i * 4);
                else if (comp == 5123) o[i] = BitConverter.ToUInt16(bytes, start + i * 2);
                else throw new Exception("indice type " + comp);
            }
            return o;
        }

        static Dictionary<string, object> FindMeshNode(List<object> nodes, List<object> roots)
        {
            foreach (var r in roots)
            {
                var n = (Dictionary<string, object>)nodes[Convert.ToInt32((double)r)];
                if (n.ContainsKey("mesh")) return n;
                if (n.ContainsKey("children"))
                {
                    var c = FindMeshNode(nodes, (List<object>)n["children"]);
                    if (c != null) return c;
                }
            }
            return null;
        }

        static class MiniJson
        {
            public static object Parse(string s) { int i = 0; Skip(s, ref i); var v = Val(s, ref i); return v; }
            static void Skip(string s, ref int i) { while (i < s.Length && char.IsWhiteSpace(s[i])) i++; }
            static object Val(string s, ref int i)
            {
                Skip(s, ref i);
                char c = s[i];
                if (c == '{')
                {
                    i++;
                    var d = new Dictionary<string, object>();
                    Skip(s, ref i);
                    if (s[i] == '}') { i++; return d; }
                    while (true)
                    {
                        Skip(s, ref i);
                        string k = Str(s, ref i);
                        Skip(s, ref i); i++;
                        d[k] = Val(s, ref i);
                        Skip(s, ref i);
                        if (s[i] == ',') { i++; continue; }
                        if (s[i] == '}') { i++; break; }
                        throw new Exception("json objeto");
                    }
                    return d;
                }
                if (c == '[')
                {
                    i++;
                    var l = new List<object>();
                    Skip(s, ref i);
                    if (s[i] == ']') { i++; return l; }
                    while (true)
                    {
                        l.Add(Val(s, ref i));
                        Skip(s, ref i);
                        if (s[i] == ',') { i++; continue; }
                        if (s[i] == ']') { i++; break; }
                        throw new Exception("json lista");
                    }
                    return l;
                }
                if (c == '"') return Str(s, ref i);
                if (c == 't') { i += 4; return true; }
                if (c == 'f') { i += 5; return false; }
                if (c == 'n') { i += 4; return null; }
                int st = i;
                while (i < s.Length && "-+0123456789.eE".IndexOf(s[i]) >= 0) i++;
                string tok = s.Substring(st, i - st);
                try { return double.Parse(tok, CultureInfo.InvariantCulture); }
                catch { throw new Exception("num [" + tok + "]"); }
            }
            static string Str(string s, ref int i)
            {
                i++;
                var sb = new StringBuilder();
                while (true)
                {
                    char c = s[i++];
                    if (c == '"') break;
                    if (c == '\\')
                    {
                        char e = s[i++];
                        if (e == 'u') { sb.Append((char)Convert.ToInt32(s.Substring(i, 4), 16)); i += 4; }
                        else if (e == 'n') sb.Append('\n');
                        else if (e == 't') sb.Append('\t');
                        else sb.Append(e);
                    }
                    else sb.Append(c);
                }
                return sb.ToString();
            }
        }

