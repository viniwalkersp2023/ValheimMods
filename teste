        void Update()
        {
            try
            {
                if (Input.GetKeyDown(KeyCode.F6)) DumpHammer();
                if (_dialogOpen && Input.GetKeyDown(KeyCode.Escape)) _dialogOpen = false;
                // Limpa totens-fantasma da versao bugada (template com ZNetView vivo).
                // Nenhum totem legitimo existia antes desta versao, entao qualquer
                // ViniSkillTotem na cena que nao seja o template registrado e lixo.
                if (_swept) return;
                if (Player.m_localPlayer == null || ZNetScene.instance == null) return;
                if (_sweepAt == 0f) { _sweepAt = Time.time + 5f; return; }
                if (Time.time < _sweepAt) return;
                _swept = true;
                SweepStrays();
                UpgradePlacedTotems();
            }
            catch { }
        }

        static void SweepStrays()
        {
            try
            {
                int n = 0;
                var all = GameObject.FindObjectsByType<GameObject>(FindObjectsInactive.Include, FindObjectsSortMode.None);
                foreach (var go in all)
                {
                    if (go == null || go == _template) continue;
                    if (go.name != PrefabName && go.name != PrefabName + "(Clone)") continue;
                    if (ZNetScene.instance != null && ZNetScene.instance.m_prefabs.Contains(go)) continue;
                    // So varre inativos + clones ativos perto da origem (onde o template bugado ficava).
                    // Totem legitimo e colocado pelo jogador em outro lugar: preservado.
                    bool nearOrigin = go.transform.position.sqrMagnitude < 2500f;
                    if (go.activeInHierarchy && !nearOrigin) continue;
                    var v = go.GetComponent<ZNetView>();
                    if (v != null)
                    {
                        try
                        {
                            var zdo = v.GetZDO();
                            if (zdo != null && ZDOMan.instance != null) ZDOMan.instance.DestroyZDO(zdo);
                        }
                        catch { }
                    }
                    UnityEngine.Object.Destroy(go);
                    n++;
                }
                Log("varredura de fantasmas: " + n + " removidos.");
            }
            catch (Exception e) { Log("varredura falhou: " + e.Message); }
        }

