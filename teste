        // Pede ao PlanBuild para reescanear as pecas (cria a versao "plan" do
        // totem, que e a unica que o menu visivel mostra). So uma vez por sessao.
        static void TriggerPlanRescan()
        {
            if (_planScanDone || !_planScanCanTry) return;
            try
            {
                foreach (var a in System.AppDomain.CurrentDomain.GetAssemblies())
                {
                    if (a.GetName().Name != "PlanBuild") continue;
                    var pdbType = a.GetType("PlanBuild.Plans.PlanDB");
                    if (pdbType == null) { _planScanDone = true; return; }
                    object inst = null;
                    try
                    {
                        var prop = pdbType.GetProperty("Instance", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static);
                        if (prop != null) inst = prop.GetValue(null, null);
                        if (inst == null)
                        {
                            var fld = pdbType.GetField("Instance", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static);
                            if (fld != null) inst = fld.GetValue(null);
                        }
                        if (inst == null)
                            foreach (var o in Resources.FindObjectsOfTypeAll(pdbType)) { inst = o; break; }
                    }
                    catch { }
                    if (inst == null) return; // PlanBuild ainda nao pronto; tenta depois
                    var scan = pdbType.GetMethod("ScanPieceTables", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance);
                    if (scan == null) { _planScanDone = true; return; }
                    scan.Invoke(inst, null);
                    _planScanDone = true;
                    Log("PlanBuild rescan solicitado.");
                }
            }
            catch (Exception e)
            {
                if (_planScanFailedOnce) return;
                _planScanFailedOnce = true;
                string inner = e.InnerException != null ? (" <- " + e.InnerException.GetType().Name + ": " + e.InnerException.Message) : "";
                Log("plan rescan falhou: " + e.GetType().Name + ": " + e.Message + inner);
            }
        }

