                try
                {
                    var hudType = typeof(Hud);
                    var instProp = hudType.GetProperty("instance", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static);
                    var hud = instProp != null ? instProp.GetValue(null, null) : null;
