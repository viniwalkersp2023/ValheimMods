        // ============ VISUAL CUSTOM (.glb) ============
        static GameObject _customProto = null;

        static GameObject GetCustomProto()
        {
            if (_customProto != null) return _customProto;
            try
            {
                string cfg = _inst != null ? _inst._glbFile.Value : "tonzite_final.glb";
                if (string.IsNullOrEmpty(cfg)) return null;
                string path = cfg;
                if (!Path.IsPathRooted(path))
                    path = Path.Combine(Path.GetDirectoryName(Assembly.GetExecutingAssembly().Location), cfg);
                if (!File.Exists(path)) return null;
                Log("lendo glb: " + path);
                var vis = LoadGlbVisual(path);
                if (vis == null) return null;
                vis.name = "TotemCustom";
                vis.SetActive(false);
                _customProto = vis;
                Log("visual custom pronto (" + Path.GetFileName(path) + ").");
                return vis;
            }
            catch (Exception e) { Log("visual custom falhou: " + e.ToString()); return null; }
        }

        static bool HasCustomChild(GameObject root)
        {
            try
            {
                foreach (Transform c in root.transform)
                    if (c != null && c.name.StartsWith("TotemCustom")) return true;
            }
            catch { }
            return false;
        }

        static bool IsUnderCustom(Transform t)
        {
            try
            {
                while (t != null)
                {
                    if (t.name.StartsWith("TotemCustom")) return true;
                    t = t.parent;
                }
            }
            catch { }
            return false;
        }

        static bool AttachCustomVisual(GameObject root, bool setIcon)
        {
            var proto = GetCustomProto();
            if (proto == null) return false;
            // Mata tudo da ward (luz, particulas, meshes) fora do custom, sempre
            // (cobre tambem totens ja atualizados antes deste fix).
            foreach (var l in root.GetComponentsInChildren<Light>(true))
                try { if (l != null && !IsUnderCustom(l.transform)) l.enabled = false; } catch { }
            foreach (var ps in root.GetComponentsInChildren<ParticleSystem>(true))
                try { if (ps != null && !IsUnderCustom(ps.transform)) ps.gameObject.SetActive(false); } catch { }
            foreach (var r in root.GetComponentsInChildren<MeshRenderer>(true))
                try { if (r != null && !IsUnderCustom(r.transform)) r.gameObject.SetActive(false); } catch { }
            if (!HasCustomChild(root))
            {
                var inst = UnityEngine.Object.Instantiate(proto);
                inst.name = "TotemCustom";
                inst.transform.SetParent(root.transform, false);
                inst.transform.localPosition = Vector3.zero;
                inst.SetActive(true);
            }
            // Troca colisores da ward por um box ajustado (senao nao da pra
            // mirar/interagir e atravessa o relevo).
            try
            {
                foreach (var c in root.GetComponentsInChildren<Collider>(true))
                    try { if (c != null && !IsUnderCustom(c.transform)) UnityEngine.Object.Destroy(c); } catch { }
                Mesh useMesh = null;
                foreach (Transform ch in root.transform)
                    if (ch != null && ch.name.StartsWith("TotemCustom"))
                    {
                        var mff = ch.GetComponent<MeshFilter>();
                        if (mff != null) useMesh = mff.sharedMesh;
                    }
                if (useMesh != null)
                {
                    var box = root.GetComponent<BoxCollider>();
                    if (box == null) box = root.AddComponent<BoxCollider>();
                    var b = useMesh.bounds;
                    box.size = b.size + new Vector3(0.4f, 0.2f, 0.4f);
                    box.center = b.center;
                }
            }
            catch { }
            if (setIcon)
            {
                MeshRenderer rend = null;
                foreach (Transform ch in root.transform)
                    if (ch != null && ch.name.StartsWith("TotemCustom"))
                    {
                        rend = ch.GetComponent<MeshRenderer>();
                        break;
                    }
                var piece = root.GetComponent<Piece>();
                if (piece != null && rend != null && rend.sharedMaterial != null)
                {
                    var tex = rend.sharedMaterial.mainTexture as Texture2D;
                    if (tex != null)
                    {
                        try { piece.m_icon = Sprite.Create(tex, new Rect(0, 0, tex.width, tex.height), new Vector2(0.5f, 0.5f)); }
                        catch { }
                    }
                }
            }
            return true;
        }

        static bool TryApplyCustomVisual(GameObject root)
        {
            try
