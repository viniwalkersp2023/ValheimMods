        // Aplica visual+interacao tambem na copia "plan" do PlanBuild (e dela que
        // saem os totens colocados via plano). Idempotente por sessao.
        static void EnsurePlanCopyMods()
        {
            if (_planCopyDone) return;
            try
            {
                System.Reflection.Assembly pb = null;
                foreach (var a in System.AppDomain.CurrentDomain.GetAssemblies())
                    if (a.GetName().Name == "PlanBuild") { pb = a; break; }
                if (pb == null) { _planCopyDone = true; return; }
                var pdbT = pb.GetType("PlanBuild.Plans.PlanDB");
                if (pdbT == null) { _planCopyDone = true; return; }
                object inst = null;
                try
                {
                    var prop = pdbT.GetProperty("Instance", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static);
                    if (prop != null) inst = prop.GetValue(null, null);
                    if (inst == null)
                    {
                        var fld = pdbT.GetField("Instance", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Static);
                        if (fld != null) inst = fld.GetValue(null);
                    }
                    if (inst == null)
                        foreach (var o in Resources.FindObjectsOfTypeAll(pdbT)) { inst = o; break; }
                }
                catch { }
                if (inst == null) return;
                var mapF = pdbT.GetField("OriginalToPlanMap", BindingFlags.Public | BindingFlags.NonPublic | BindingFlags.Instance);
                if (mapF == null) { _planCopyDone = true; return; }
                var map = mapF.GetValue(inst) as System.Collections.IDictionary;
                if (map == null || !map.Contains(PrefabName)) return;
                string planName = map[PrefabName] as string;
                if (string.IsNullOrEmpty(planName)) { _planCopyDone = true; return; }
                GameObject planPrefab = null;
                try { planPrefab = ZNetScene.instance != null ? ZNetScene.instance.GetPrefab(planName) : null; } catch { }
                if (planPrefab == null) return;
                if (planPrefab.GetComponent<TotemInteract>() == null)
                {
                    try { planPrefab.AddComponent<TotemInteract>(); } catch { }
                }
                if (AttachCustomVisual(planPrefab, false)) Log("plan copy ok.");
                _planCopyDone = true;
            }
            catch (Exception e) { Log("plan copy: " + e.Message); }
        }
