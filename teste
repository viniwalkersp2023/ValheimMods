        void DrawDialog(int id)
        {
            try
            {
                var p = Player.m_localPlayer;
                if (p == null) return;
                GUILayout.Label("TOTEM DA SEGUNDA CHANCE", ViniUI.Title());
                GUILayout.Label("por viniwalkersp", ViniUI.Sub());
                GUILayout.Space(6);

                var sk = p.GetComponent<Skills>();
                bool inWin; float left;
                WindowInfo(p, out inWin, out left);
                float total = LostTotal();
                int coins = CountCoins(p);
                int price = _price.Value;

                if (Claimed && Lost.Count == 0)
                {
                    GUILayout.Label("Habilidades restauradas! (" + RestoredTotal.ToString("F1") + " niveis)", ViniUI.Center());
                    GUILayout.Space(4);
                    GUILayout.Label("Boa sorte, guerreiro. Nao morra de novo.", ViniUI.Center());
                }
                else if (Lost.Count == 0 || total < 0.05f)
                {
                    GUILayout.Label("Nenhuma perda recente registrada.", ViniUI.Center());
                    GUILayout.Space(4);
                    GUILayout.Label("Se voce morrer, volte a este totem em ate 10 min para recuperar seus niveis.", ViniUI.Center());
                }
                else if (!inWin)
                {
                    GUILayout.Label("A protecao de 10 min acabou.", ViniUI.Center());
                    GUILayout.Space(4);
                    GUILayout.Label("A perda desta morte nao pode mais ser recuperada.", ViniUI.Center());
                }
                else
                {
                    int mm = (int)(left / 60f), ss = (int)(left % 60f);
                    GUILayout.Label("Voce perdeu " + total.ToString("F1") + " niveis. Tempo restante: " + mm + ":" + ss.ToString("D2"), ViniUI.Center());
                    GUILayout.Space(4);
                    _scroll = GUILayout.BeginScrollView(_scroll, GUILayout.Height(220));
                    foreach (var kv in Lost)
                    {
                        float cur = sk != null ? sk.GetSkillLevel(kv.Key) : 0f;
                        GUILayout.Label("- " + SkillName(kv.Key, sk) + ": " + cur.ToString("F1") + " (-" + kv.Value.ToString("F1") + ")", ViniUI.Center());
                    }
                    GUILayout.EndScrollView();
                    GUILayout.Space(4);
                    GUILayout.Label("Moedas: " + coins + " / " + price, ViniUI.Center());
                    GUILayout.Space(4);
                    GUI.enabled = coins >= price;
                    Color oldBg = GUI.backgroundColor;
                    GUI.backgroundColor = new Color(0.17f, 0.44f, 0.19f);
                    if (GUILayout.Button("Recuperar (-" + price + " moedas)", ViniUI.Big(), GUILayout.Height(36))) BuyRestore(p);
                    GUI.backgroundColor = oldBg;
                    GUI.enabled = true;
                    if (coins < price) GUILayout.Label("Moedas insuficientes!", ViniUI.Center());
                }
                GUILayout.Space(8);
                Color bg2 = GUI.backgroundColor;
                GUI.backgroundColor = new Color(0.15f, 0.12f, 0.085f);
                if (GUILayout.Button("Fechar", ViniUI.Btn(), GUILayout.Height(30))) _dialogOpen = false;
                GUI.backgroundColor = bg2;
            }
            catch (Exception e) { Log("dialogo falhou: " + e.Message); _dialogOpen = false; }
        }

