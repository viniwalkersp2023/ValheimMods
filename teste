        // ============ PEÇA DO MARTELO ============
        public static void EnsureInHammerTable(PieceTable table)
        {
            try
            {
                EnsureTemplate();
                if (_template == null) return;
                var piece = _template.GetComponent<Piece>();
                if (piece == null) return;
                // A tabela do martelo sobrevive a troca de sessao/personagem, mas os
                // GameObjects da cena nao. Sem esta limpeza, a referencia morta do
                // template da sessao anterior fica em m_pieces e ObjectDB.GetAllBuildPieces
                // (usado pelo mod de conquistas) quebra com NRE todo frame, congelando o jogo.
                table.m_pieces.RemoveAll(g => g == null || (g != _template && g.name == PrefabName));
                table.m_enabledPieces.RemoveWhere(p => p == null || (p.gameObject != _template && p.gameObject.name == PrefabName));
                table.m_availablePieces.RemoveWhere(p => p == null || (p.gameObject != _template && p.gameObject.name == PrefabName));
                // Tabela de plans do PlanBuild: nao recebe a peca crua (o menu so
                // mostra versoes "plan", geradas pelo rescan). So limpa + rescan.
                if (table.gameObject != null && table.gameObject.name == "_PlanHammerPieceTable") return;
                if (!table.m_pieces.Contains(_template)) table.m_pieces.Add(_template);
                if (piece.m_placeEffect == null)
                    foreach (var go in table.m_pieces)
                    {
                        if (go == null || go == _template) continue;
                        var q = go.GetComponent<Piece>();
                        if (q != null && q.m_placeEffect != null) { piece.m_placeEffect = q.m_placeEffect; break; }
                    }
                table.m_enabledPieces.Add(piece);
                table.m_availablePieces.Add(piece);
                if (_inst != null) _inst.Logger.LogInfo("[ViniTotem] totem injetado na tabela " + table.gameObject.name + " (pecas=" + table.m_pieces.Count + ").");
            }
            catch { }
        }

        // ============ TOTEM TEMPLATE ============
        static Material StealMaterial(bool emissive, bool opaqueOnly = false)
        {
            try
            {
                var zns = ZNetScene.instance;
                if (zns == null || zns.m_prefabs == null) return null;
                Material baseMat = null;
                foreach (var p in zns.m_prefabs)
                {
                    if (p == null) continue;
                    var r = p.GetComponentInChildren<MeshRenderer>(true);
                    if (r != null && r.sharedMaterial != null && r.sharedMaterial.shader != null
                        && r.sharedMaterial.shader.name.Contains("Standard")
                        && (!opaqueOnly || r.sharedMaterial.renderQueue < 2500)) { baseMat = r.sharedMaterial; break; }
                }
                if (baseMat == null)
                    foreach (var p in zns.m_prefabs)
                    {
                        if (p == null) continue;
                        var r = p.GetComponentInChildren<MeshRenderer>(true);
                        if (r != null && r.sharedMaterial != null
                            && (!opaqueOnly || r.sharedMaterial.renderQueue < 2500)) { baseMat = r.sharedMaterial; break; }
                    }
                if (baseMat == null) return null;
                var m = UnityEngine.Object.Instantiate(baseMat);
                if (m.HasProperty("_Color")) m.color = emissive ? new Color(0.05f, 0.12f, 0.14f) : new Color(0.32f, 0.32f, 0.37f);
                if (emissive && m.HasProperty("_EmissionColor"))
                {
                    m.SetColor("_EmissionColor", new Color(0.2f, 0.85f, 1f) * 1.6f);
                    m.EnableKeyword("_EMISSION");
                }
                else if (emissive && m.HasProperty("_Color")) m.color = new Color(0.2f, 0.85f, 1f);
                return m;
            }
            catch { return null; }
        }

        public static void EnsureTemplate()
        {
            if (_template != null) return;
            if (_useJotunn) { EnsureJotunnTotem(); if (_template != null) return; }
            var zns = ZNetScene.instance;
            if (zns == null || zns.m_prefabs == null) return;
            foreach (var p in zns.m_prefabs)
                if (p != null && p.name == PrefabName) { _template = p; return; }
            try
            {
                GameObject wardPrefab = zns.GetPrefab("guard_stone");
                if (wardPrefab != null && BuildFromWard(wardPrefab, zns)) return;
                BuildPrimitive(zns);
            }
            catch (Exception e) { if (_inst != null) _inst.Logger.LogError("[ViniTotem] template falhou: " + e); }
        }

        // Caminho Jotunn: usa o prefab ja registrado/clonado por ele e so
        // remove a logica da ward + adiciona interacao/icone proprios.
        static void EnsureJotunnTotem()
        {
            if (_jotunnReady) return;
            GameObject prefab = null;
            try { prefab = JotunnBridge.FetchTotem(); }
            catch { return; }
            if (prefab == null) return;
            try
            {
                foreach (var mb in prefab.GetComponentsInChildren<MonoBehaviour>(true))
                {
                    if (mb == null) continue;
                    var t = mb.GetType();
                    if (t == typeof(ZNetView) || t == typeof(Piece) || t == typeof(WearNTear) || t == typeof(TotemInteract)) continue;
                    UnityEngine.Object.Destroy(mb);
                }
                foreach (var r in prefab.GetComponentsInChildren<Renderer>(true))
                {
                    if (r == null) continue;
                    string n = r.gameObject.name.ToLowerInvariant();
                    if (n.Contains("bubble") || n.Contains("shield") || n.Contains("field") || n.Contains("area") || n.Contains("fx") || n.Contains("effect"))
                        r.gameObject.SetActive(false);
                }
                if (prefab.GetComponent<TotemInteract>() == null) prefab.AddComponent<TotemInteract>();
                var piece = prefab.GetComponent<Piece>();
                if (piece != null && piece.m_icon == null) piece.m_icon = StealIcon();
                TryApplyCustomVisual(prefab);
                _template = prefab;
                _jotunnReady = true;
                Log("template Jotunn ok.");
            }
            catch { }
        }

        static Sprite StealIcon()
        {
            try
            {
                var zns = ZNetScene.instance;
                if (zns == null) return null;
                foreach (var n in new string[] { "SurtlingCore", "GreydwarfEye", "Coins", "FineWood" })
                {
                    var d = zns.GetPrefab(n)?.GetComponent<ItemDrop>();
                    if (d != null && d.m_itemData != null && d.m_itemData.m_shared != null
                        && d.m_itemData.m_shared.m_icons != null && d.m_itemData.m_shared.m_icons.Length > 0
                        && d.m_itemData.m_shared.m_icons[0] != null)
                        return d.m_itemData.m_shared.m_icons[0];
                }
            }
            catch { }
            return null;
        }

        // Clona a ward (guard_stone): visual, icone e efeito de colocacao vanilla.
        // Remove a logica da ward (bolha de protecao + E de ligar/desligar) e
        // configura como peca propria. m_forceDisableInit impede que o ZNetView
        // acorde durante o Instantiate e crie um ZDO fantasma (o bug do flood).
        static bool BuildFromWard(GameObject wardPrefab, ZNetScene zns)
        {
            try
            {
                ZNetView.m_forceDisableInit = true;
                GameObject go = null;
                try { go = UnityEngine.Object.Instantiate(wardPrefab); }
                finally { ZNetView.m_forceDisableInit = false; }
                if (go == null) return false;
                go.name = PrefabName;
                go.SetActive(false);
                foreach (var mb in go.GetComponentsInChildren<MonoBehaviour>(true))
                {
                    if (mb == null) continue;
                    var t = mb.GetType();
                    if (t == typeof(ZNetView) || t == typeof(Piece) || t == typeof(WearNTear)) continue;
                    Log("removido do totem: " + t.Name);
                    UnityEngine.Object.Destroy(mb);
                }
                foreach (var r in go.GetComponentsInChildren<Renderer>(true))
                {
                    if (r == null) continue;
                    string n = r.gameObject.name.ToLowerInvariant();
                    if (n.Contains("bubble") || n.Contains("shield") || n.Contains("field") || n.Contains("area") || n.Contains("fx") || n.Contains("effect"))
                    {
                        Log("visual escondido: " + r.gameObject.name);
                        r.gameObject.SetActive(false);
                    }
                }
                go.AddComponent<ZNetView>();
                go.AddComponent<TotemInteract>();
                var piece = go.GetComponent<Piece>();
                if (piece == null) { UnityEngine.Object.Destroy(go); return false; }
                ItemDrop wood = zns.GetPrefab("FineWood")?.GetComponent<ItemDrop>();
                ItemDrop core = zns.GetPrefab("SurtlingCore")?.GetComponent<ItemDrop>();
                ItemDrop eye = zns.GetPrefab("GreydwarfEye")?.GetComponent<ItemDrop>();
                ItemDrop coins = zns.GetPrefab("Coins")?.GetComponent<ItemDrop>();
                var forge = zns.GetPrefab("forge")?.GetComponent<CraftingStation>();
                piece.m_name = "Totem da Segunda Chance";
                piece.m_description = "Quem morreu pode recuperar as habilidades perdidas (use com E).";
                // NAO sobrescrever m_category: o martelo so mostra abas existentes;
                // mantendo a categoria nativa da ward, o totem aparece na mesma aba dela.
                // Uso fixo: a ward vem com todas as flags de uso (aparecia nas 18 abas
                // e ninguem achava); Misc deixa num lugar unico (fallback sem Jotunn).
                piece.m_usage = Piece.UsageTagFlags.Misc;
                piece.m_enabled = true;
                piece.m_canRotate = true;
                piece.m_repairPiece = true;
                piece.m_removePiece = true;
                piece.m_canBeRemoved = true;
                piece.m_craftingStation = forge;
                piece.m_canRotate = true;
                piece.m_repairPiece = true;
                piece.m_removePiece = true;
                piece.m_canBeRemoved = true;
                piece.m_craftingStation = forge;
                if (wood != null && core != null && eye != null && coins != null)
                    piece.m_resources = new Piece.Requirement[]
                    {
                        new Piece.Requirement() { m_resItem = wood, m_amount = 30, m_recover = true },
                        new Piece.Requirement() { m_resItem = core, m_amount = 5, m_recover = true },
                        new Piece.Requirement() { m_resItem = eye, m_amount = 10, m_recover = true },
                        new Piece.Requirement() { m_resItem = coins, m_amount = 500, m_recover = true },
                    };
                TryApplyCustomVisual(go);
                zns.m_prefabs.Add(go);
                _template = go;
                Log("template ward ok (visual/icone/efeito da ward).");
                return true;
            }
            catch (Exception e) { Log("ward falhou, usando primitivo: " + e.Message); return false; }
        }

        static void BuildPrimitive(ZNetScene zns)
        {
                GameObject root = new GameObject(PrefabName);
                // CRITICO: desativar ANTES de AddComponent. Se o ZNetView acordar (Awake)
                // com o objeto ativo, ele cria um ZDO vivo e registra em ZNetScene.m_instances;
                // ao desativar depois, a view orfa (ZDO nulo) e ZNetScene.RemoveObjects
                // quebra com NRE todo frame. Template tem que nascer morto.
                root.SetActive(false);
                Material stone = StealMaterial(false);
                Material glow = StealMaterial(true);
                if (stone == null || glow == null)
                {
                    if (_inst != null) _inst.Logger.LogError("[ViniTotem] nenhum material vanilla achado; adiando template.");
                    UnityEngine.Object.Destroy(root);
                    return;
                }

                var b = GameObject.CreatePrimitive(PrimitiveType.Cube);
                b.transform.SetParent(root.transform, false);
                b.transform.localScale = new Vector3(1.9f, 0.6f, 1.9f);
                b.transform.localPosition = new Vector3(0f, 0.3f, 0f);
                b.GetComponent<MeshRenderer>().sharedMaterial = stone;

                var col = GameObject.CreatePrimitive(PrimitiveType.Cylinder);
                col.transform.SetParent(root.transform, false);
                col.transform.localScale = new Vector3(1.15f, 3.1f, 1.15f);
                col.transform.localPosition = new Vector3(0f, 2.15f, 0f);
                col.GetComponent<MeshRenderer>().sharedMaterial = stone;

                var band = GameObject.CreatePrimitive(PrimitiveType.Cylinder);
                band.transform.SetParent(root.transform, false);
                band.transform.localScale = new Vector3(1.22f, 0.28f, 1.22f);
                band.transform.localPosition = new Vector3(0f, 2.9f, 0f);
                band.GetComponent<MeshRenderer>().sharedMaterial = glow;
                var bandCol = band.GetComponent<Collider>();
                if (bandCol != null) UnityEngine.Object.Destroy(bandCol);

                var cap = GameObject.CreatePrimitive(PrimitiveType.Cube);
                cap.transform.SetParent(root.transform, false);
                cap.transform.localScale = new Vector3(1.35f, 0.35f, 1.35f);
                cap.transform.localPosition = new Vector3(0f, 3.87f, 0f);
                cap.GetComponent<MeshRenderer>().sharedMaterial = stone;

                var box = root.AddComponent<BoxCollider>();
                box.size = new Vector3(1.9f, 4.1f, 1.9f);
                box.center = new Vector3(0f, 2.05f, 0f);
                root.AddComponent<ZNetView>();
                root.AddComponent<TotemInteract>();
                SetupPiece(root);
                TryApplyCustomVisual(root);
                zns.m_prefabs.Add(root);
                _template = root;
                if (_inst != null) _inst.Logger.LogInfo("[ViniTotem] template primitivo ok.");
        }

        static void SetupPiece(GameObject root)
        {
            try
            {
                var zns = ZNetScene.instance;
                ItemDrop wood = zns.GetPrefab("FineWood")?.GetComponent<ItemDrop>();
                ItemDrop core = zns.GetPrefab("SurtlingCore")?.GetComponent<ItemDrop>();
                ItemDrop eye = zns.GetPrefab("GreydwarfEye")?.GetComponent<ItemDrop>();
                ItemDrop coins = zns.GetPrefab("Coins")?.GetComponent<ItemDrop>();
                var forge = zns.GetPrefab("forge")?.GetComponent<CraftingStation>();
                if (wood == null || core == null || eye == null || coins == null)
                {
                    if (_inst != null) _inst.Logger.LogError("[ViniTotem] itens de custo nao achados (wood/core/eye/coins).");
                    return;
                }
                var piece = root.AddComponent<Piece>();
                piece.m_name = "Totem da Segunda Chance";
                piece.m_description = "Quem morreu pode recuperar as habilidades perdidas (use com E).";
                piece.m_category = Piece.PieceCategory.Misc;
                piece.m_enabled = true;
                piece.m_canRotate = true;
                piece.m_repairPiece = true;
                piece.m_removePiece = true;
                piece.m_canBeRemoved = true;
                piece.m_craftingStation = forge;
                Sprite icon = null;
                foreach (var d in new ItemDrop[] { core, eye, coins, wood })
                {
                    try
                    {
                        if (d != null && d.m_itemData != null && d.m_itemData.m_shared != null
                            && d.m_itemData.m_shared.m_icons != null && d.m_itemData.m_shared.m_icons.Length > 0
                            && d.m_itemData.m_shared.m_icons[0] != null)
                        { icon = d.m_itemData.m_shared.m_icons[0]; break; }
                    }
                    catch { }
                }
                piece.m_icon = icon;
                piece.m_resources = new Piece.Requirement[]
                {
                    new Piece.Requirement() { m_resItem = wood, m_amount = 30, m_recover = true },
                    new Piece.Requirement() { m_resItem = core, m_amount = 5, m_recover = true },
                    new Piece.Requirement() { m_resItem = eye, m_amount = 10, m_recover = true },
                    new Piece.Requirement() { m_resItem = coins, m_amount = 500, m_recover = true },
                };
                if (forge == null && _inst != null) _inst.Logger.LogWarning("[ViniTotem] forja nao achada; totem sem exigencia de estacao.");
            }
            catch (Exception e) { if (_inst != null) _inst.Logger.LogError("[ViniTotem] SetupPiece: " + e); }
        }

