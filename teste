        static GameObject LoadGlbVisual(string path)
        {
            byte[] bytes = File.ReadAllBytes(path);
            if (bytes.Length < 20 || Encoding.ASCII.GetString(bytes, 0, 4) != "glTF") { Log("nao e glb valido."); return null; }
            int jsonLen = BitConverter.ToInt32(bytes, 12);
            string ctype = Encoding.ASCII.GetString(bytes, 16, 4);
            if (ctype != "JSON") { Log("chunk JSON nao achado."); return null; }
            string json = Encoding.UTF8.GetString(bytes, 20, jsonLen);
            int binPos = 20 + jsonLen;
            int binStart = binPos + 8;
            var root = MiniJson.Parse(json) as Dictionary<string, object>;
            if (root == null) return null;
            var scenes = (List<object>)root["scenes"];
            var scene = (Dictionary<string, object>)scenes[Convert.ToInt32((double)root["scene"])];
            var sceneNodes = (List<object>)scene["nodes"];
            var nodes = (List<object>)root["nodes"];
            var node = FindMeshNode(nodes, sceneNodes);
            if (node == null) { Log("glb sem mesh."); return null; }
            float nsx = 1f, nsy = 1f, nsz = 1f, ntx = 0f, nty = 0f, ntz = 0f;
            if (node.ContainsKey("scale")) { var scl = (List<object>)node["scale"]; nsx = (float)(double)scl[0]; nsy = (float)(double)scl[1]; nsz = (float)(double)scl[2]; }
            if (node.ContainsKey("translation")) { var trl = (List<object>)node["translation"]; ntx = (float)(double)trl[0]; nty = (float)(double)trl[1]; ntz = (float)(double)trl[2]; }
            var meshes = (List<object>)root["meshes"];
            var meshDef = (Dictionary<string, object>)meshes[Convert.ToInt32((double)node["mesh"])];
            var prims = (List<object>)meshDef["primitives"];
            var prim = (Dictionary<string, object>)prims[0];
            var attrs = (Dictionary<string, object>)prim["attributes"];
            var accessors = (List<object>)root["accessors"];
            var bufferViews = (List<object>)root["bufferViews"];
            float[] pos = ReadAccFloats(bytes, binStart, accessors, bufferViews, Convert.ToInt32((double)attrs["POSITION"]));
            float[] nor = ReadAccFloats(bytes, binStart, accessors, bufferViews, Convert.ToInt32((double)attrs["NORMAL"]));
            float[] uv = ReadAccFloats(bytes, binStart, accessors, bufferViews, Convert.ToInt32((double)attrs["TEXCOORD_0"]));
            int[] idx = ReadAccIndices(bytes, binStart, accessors, bufferViews, Convert.ToInt32((double)prim["indices"]));
            int vc = pos.Length / 3;
            // uv transform (KHR_texture_transform da baseColor)
            float usx = 1f, usy = 1f, uox = 0f, uoy = 0f;
            try
            {
                var mats = (List<object>)root["materials"];
                var mat0 = (Dictionary<string, object>)mats[Convert.ToInt32((double)prim["material"])];
                var pbr = (Dictionary<string, object>)mat0["pbrMetallicRoughness"];
                var bct = (Dictionary<string, object>)pbr["baseColorTexture"];
                var ext = (Dictionary<string, object>)bct["extensions"];
                var khr = (Dictionary<string, object>)ext["KHR_texture_transform"];
                var sc = (List<object>)khr["scale"]; usx = (float)(double)sc[0]; usy = (float)(double)sc[1];
                var off = (List<object>)khr["offset"]; uox = (float)(double)off[0]; uoy = (float)(double)off[1];
            }
            catch { }
            // textura baseColor
            Texture2D albedo = null;
            try
            {
                var mats = (List<object>)root["materials"];
                var mat0 = (Dictionary<string, object>)mats[Convert.ToInt32((double)prim["material"])];
                var pbr = (Dictionary<string, object>)mat0["pbrMetallicRoughness"];
                var bct = (Dictionary<string, object>)pbr["baseColorTexture"];
                var textures = (List<object>)root["textures"];
                var tex = (Dictionary<string, object>)textures[Convert.ToInt32((double)bct["index"])];
                var images = (List<object>)root["images"];
                var img = (Dictionary<string, object>)images[Convert.ToInt32((double)tex["source"])];
                string mime = img.ContainsKey("mimeType") ? (string)img["mimeType"] : "";
                Log("albedo: texIdx=" + bct["index"] + " img=" + (img.ContainsKey("name") ? img["name"] : "?") + " " + mime);
                if (mime == "image/png" || mime == "image/jpeg")
                {
                    var bv = (Dictionary<string, object>)bufferViews[Convert.ToInt32((double)img["bufferView"])];
                    int off = binStart + Convert.ToInt32((double)bv["byteOffset"]);
                    int len = Convert.ToInt32((double)bv["byteLength"]);
                    byte[] png = new byte[len];
                    Buffer.BlockCopy(bytes, off, png, 0, len);
                    albedo = new Texture2D(2, 2);
                    if (!albedo.LoadImage(png)) { Log("LoadImage falhou."); return null; }
                    albedo.wrapMode = TextureWrapMode.Repeat;
                    albedo.filterMode = FilterMode.Trilinear;
                    albedo.anisoLevel = 4;
                    try
                    {
                        var px = albedo.GetPixels();
                        for (int i = 0; i < px.Length; i++)
                        {
                            px[i].r = Mathf.Min(1f, px[i].r * 1.7f);
                            px[i].g = Mathf.Min(1f, px[i].g * 1.7f);
                            px[i].b = Mathf.Min(1f, px[i].b * 1.7f);
                        }
                        albedo.SetPixels(px);
                        albedo.Apply(false);
                    }
                    catch (Exception e) { Log("brilho falhou: " + e.Message); }
                }
                else Log("textura nao suportada: " + mime);
            }
            catch (Exception e) { Log("textura glb falhou: " + e.Message); }
            if (albedo == null) return null;
            // monta vertices (node TRS + auto-ajuste p/ 2.4m de altura, base no chao)
            float minX = float.MaxValue, minY = float.MaxValue, minZ = float.MaxValue;
            float maxX = float.MinValue, maxY = float.MinValue, maxZ = float.MinValue;
            Vector3[] verts = new Vector3[vc];
            for (int i = 0; i < vc; i++)
            {
                float x = pos[i * 3] * nsx + ntx, y = pos[i * 3 + 1] * nsy + nty, z = pos[i * 3 + 2] * nsz + ntz;
                verts[i] = new Vector3(x, y, z);
                if (x < minX) minX = x; if (y < minY) minY = y; if (z < minZ) minZ = z;
                if (x > maxX) maxX = x; if (y > maxY) maxY = y; if (z > maxZ) maxZ = z;
            }
            float h = Mathf.Max(0.001f, maxY - minY);
            float s = 2.4f / h;
            float cx = (minX + maxX) * 0.5f, cz = (minZ + maxZ) * 0.5f;
            Vector3[] nors = new Vector3[vc];
            Vector2[] uvs = new Vector2[vc];
            for (int i = 0; i < vc; i++)
            {
                verts[i] = new Vector3((verts[i].x - cx) * s, (verts[i].y - minY) * s, (verts[i].z - cz) * s);
                nors[i] = new Vector3(nor[i * 3], nor[i * 3 + 1], nor[i * 3 + 2]).normalized;
                uvs[i] = new Vector2(uv[i * 2] * usx + uox, uv[i * 2 + 1] * usy + uoy);
            }
            int[] tris = new int[idx.Length];
            // Sem flip: o enrolamento CCW do glTF ja aparece correto no Unity
            // (com flip ficava visivel so por tras). Cull off cobre o resto.
            for (int i = 0; i < idx.Length; i++) tris[i] = idx[i];
            var umesh = new Mesh();
            umesh.indexFormat = UnityEngine.Rendering.IndexFormat.UInt32;
            umesh.vertices = verts;
            umesh.normals = nors;
            umesh.uv = uvs;
            umesh.triangles = tris;
            umesh.RecalculateBounds();
            var baseMat = StealMaterial(false, true);
            if (baseMat == null) { Log("sem material vanilla."); return null; }
            Log("mat base: shader=" + (baseMat.shader != null ? baseMat.shader.name : "?")
                + " fila=" + baseMat.renderQueue
                + " temMainTex=" + baseMat.HasProperty("_MainTex")
                + " temColor=" + baseMat.HasProperty("_Color")
                + " temMetal=" + baseMat.HasProperty("_Metallic"));
            if (baseMat.HasProperty("_Metallic"))
            {
                try { baseMat.SetFloat("_Metallic", 0f); } catch { }
                try { baseMat.SetFloat("_Glossiness", 0.4f); } catch { }
            }
            // Forca opaco: material roubado pode ser transparente (fantasma).
            try
            {
                baseMat.SetFloat("_Mode", 0f);
                baseMat.SetInt("_SrcBlend", 1);
                baseMat.SetInt("_DstBlend", 0);
                baseMat.SetInt("_ZWrite", 1);
                baseMat.DisableKeyword("_ALPHATEST_ON");
