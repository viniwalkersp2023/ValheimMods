    [HarmonyPatch(typeof(Player), "OnDeath")]
    static class PatchDeath
    {
        static readonly Dictionary<Skills.SkillType, float> _pre = new Dictionary<Skills.SkillType, float>();
        static void Prefix(Player __instance)
        {
            try
            {
                if (__instance == null || __instance != Player.m_localPlayer) return;
                var sk = __instance.GetComponent<Skills>();
                if (sk == null) return;
                _pre.Clear();
                foreach (var s in sk.GetSkillList())
                    if (s != null && s.m_info != null) _pre[s.m_info.m_skill] = s.m_level;
            }
            catch { }
        }
        static void Postfix(Player __instance)
        {
            try
            {
                if (__instance == null || __instance != Player.m_localPlayer) return;
                var sk = __instance.GetComponent<Skills>();
                if (sk == null) return;
                bool any = false;
                foreach (var s in sk.GetSkillList())
                {
                    if (s == null || s.m_info == null) continue;
                    float before = s.m_level, b;
                    if (_pre.TryGetValue(s.m_info.m_skill, out b)) before = b;
                    float diff = before - s.m_level;
                    if (diff > 0.001f)
                    {
                        float cur = 0f, c;
                        if (ViniTotemPlugin.Lost.TryGetValue(s.m_info.m_skill, out c)) cur = c;
                        ViniTotemPlugin.Lost[s.m_info.m_skill] = cur + diff;
                        any = true;
                    }
                }
                _pre.Clear();
                ViniTotemPlugin.LastDeathTime = Time.time;
                if (any) ViniTotemPlugin.Claimed = false;
            }
            catch { }
        }
    }
