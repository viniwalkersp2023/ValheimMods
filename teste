        // ============ JANELA 10 MIN (protecao do jogo) ============
        static void WindowInfo(Player p, out bool inWindow, out float left)
        {
            inWindow = false; left = 0f;
            if (p == null) return;
            try
            {
                if (_fSince != null && _fCool != null)
                {
                    float since = (float)_fSince.GetValue(p);
                    float cool = (float)_fCool.GetValue(p);
                    if (cool <= 0f) cool = 600f;
                    inWindow = since < cool;
                    left = Mathf.Max(0f, cool - since);
                    return;
                }
            }
            catch { }
            left = Mathf.Max(0f, 600f - (Time.time - LastDeathTime));
            inWindow = left > 0f;
        }

        static float LostTotal()
        {
            float t = 0f;
            foreach (var kv in Lost) t += kv.Value;
            return t;
        }

        static int CountCoins(Player p)
        {
            int n = 0;
            try
            {
                var inv = p.GetInventory();
                if (inv == null) return 0;
                foreach (var it in inv.GetAllItems())
                    if (it != null && it.m_shared != null && it.m_shared.m_name == CoinName)
                        n += it.m_stack;
            }
            catch { }
            return n;
        }

        static void RemoveCoins(Player p, int amount)
        {
            var inv = p.GetInventory();
            if (inv == null) return;
            int need = amount;
            // GetAllItems retorna a lista VIVA do inventario: copiar antes,
            // senao o foreach quebra (InvalidOperation) na primeira remocao.
            var stacks = new List<ItemDrop.ItemData>(inv.GetAllItems());
            foreach (var it in stacks)
            {
                if (need <= 0) break;
                if (it != null && it.m_shared != null && it.m_shared.m_name == CoinName && it.m_stack > 0)
                {
                    int take = Math.Min(it.m_stack, need);
                    if (inv.RemoveItem(it, take)) need -= take;
                }
            }
            if (need > 0) Log("aviso: faltaram " + need + " moedas na cobranca!");
        }

        static void BuyRestore(Player p)
        {
            int price = _inst != null ? _inst._price.Value : 3000;
            if (CountCoins(p) < price || Lost.Count == 0 || Claimed) return;
            float total = 0f;
            try
            {
                var sk = p.GetComponent<Skills>();
                if (sk != null)
                    foreach (var kv in new Dictionary<Skills.SkillType, float>(Lost))
                    {
                        sk.CheatRaiseSkill(kv.Key.ToString(), kv.Value, false);
                        total += kv.Value;
                    }
            }
            catch (Exception e) { Log("restore falhou: " + e.Message); return; }
            // So cobra DEPOIS de restaurar (se falhar, nao come moeda a toa).
            RemoveCoins(p, price);
            Lost.Clear();
            Claimed = true;
            RestoredTotal = total;
            p.Message(MessageHud.MessageType.TopLeft, "Habilidades restauradas pelo totem! (" + total.ToString("F1") + " niveis)");
        }

        static string Clean(string s)
        {
            if (string.IsNullOrEmpty(s)) return s;
            string n = s.Normalize(NormalizationForm.FormD);
            var sb = new StringBuilder(n.Length);
            foreach (char c in n)
                if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                    sb.Append(c);
            return sb.ToString().Normalize(NormalizationForm.FormC);
        }

        static string SkillName(Skills.SkillType t, Skills sk)
        {
            try
            {
                foreach (var s in sk.GetSkillList())
                    if (s != null && s.m_info != null && s.m_info.m_skill == t && !string.IsNullOrEmpty(s.m_info.m_description))
                        return Clean(Localization.instance.Localize(s.m_info.m_description));
            }
            catch { }
            return Clean(t.ToString());
        }

